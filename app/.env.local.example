# copy to .env.local and fill from your Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# notification pipeline credentials (src/lib/supabase/service.ts). Server-only,
# bypasses RLS, so it must never be prefixed NEXT_PUBLIC_. The dispatcher needs
# it because notification_templates is admin-only and the outbox is scoped to
# your own rows, so running as the acting member can neither read the template
# nor see a notification addressed to anybody else. Supabase → Settings → API →
# service_role. Without it the pipeline falls back to the member's own session
# and effectively nothing sends.
SUPABASE_SERVICE_ROLE_KEY=

# email pipeline (src/lib/email.ts) - from resend.com. Without this, queued
# email notifications are marked "logged" instead of sent (safe no-op).
RESEND_API_KEY=
EMAIL_FROM="Hive <hola@tudominio.com>"

# WhatsApp pipeline (src/lib/whatsapp.ts) - from zernio.com. All three are
# required; with any of them missing, queued WhatsApp notifications are
# marked "logged" instead of sent (safe no-op, same as email above).
# Profile and account ids come from the Zernio dashboard for the connected
# WhatsApp Business number. Never prefix these with NEXT_PUBLIC_.
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
ZERNIO_ACCOUNT_ID=

# required in production. Protects the day-of reminder job
# (src/app/api/cron/event-reminders). Vercel Cron sends it as
# "Authorization: Bearer <value>". Without it the route answers 503 and no
# reminders go out: that job also flushes the notification outbox, so leaving
# it open would let anyone drain the queue through our WhatsApp provider on
# demand.
CRON_SECRET=

# optional. Absolute origin for links inside emails and WhatsApp. On Vercel
# this is derived automatically from the deployment, so set it only for a
# custom domain. Client
# code already uses location.origin; this is only for server-sent email.
NEXT_PUBLIC_SITE_URL=https://tudominio.com
