# The local sandbox, not any deployed environment.
#
# These are the fixed demo keys every `supabase start` prints, identical on
# every machine and worthless anywhere else, which is why they are in the
# repo: the point of the sandbox is that it works after a clone with nothing
# to fetch from a password manager.
#
# Never put a real project's keys in here. Production credentials live in
# .env.local, which is gitignored.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# The demo accounts seed.sql creates, given a password by `npm run sandbox:seed`
# so a browser can sign in without a mailbox. Marta is the app admin, Ana is
# the pending account the verification queue is built around.
SANDBOX_PASSWORD=hive-sandbox
