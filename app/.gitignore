# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example env tracked (real .env.local stays ignored)
!.env.local.example
# the sandbox's env is tracked on purpose: it holds only the fixed local demo
# keys every `supabase start` prints, and the sandbox is meant to work from a
# fresh clone with nothing to fetch
!.env.sandbox

# sandbox screenshots: the output of `npm run shoot`, never a deliverable
/.sandbox-shots/

# supabase local stack state
/supabase/.branches/
/supabase/.temp/
